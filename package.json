{
  "name": "@xie-work/xie-ui",
  "version": "0.0.1",
  "description": "一个简单的ui库，基于web component实现",
  "type": "module",
  "access": "public",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vite --open /test/",
    "docs": "yarn build && vite --open /demo/",
    "demo:vue": "vite --config demo-vue/vite.config.ts --open",
    "build:demo:vue": "vite build --config demo-vue/vite.config.ts",
    "type-check:demo:vue": "vue-tsc --noEmit -p demo-vue/tsconfig.json",
    "build:all": "vite build && vite build --config demo-vue/vite.config.ts",
    "prepublishOnly": "yarn build"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiechanglei/xie-ui.git"
  },
  "homepage": "https://github.com/xiechanglei/xie-ui#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "highlight.js": "^11.12.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14"
  }
}
